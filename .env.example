# Copy this file to ".env" and fill in your own values. Never commit ".env" (it is in .gitignore).
# Every setting is optional: leave them blank and the dashboard still runs, with email and webhook alerts switched off.

# --- Email alerts (off unless BOTH the recipient and the password are set) ---
FLARE_EMAIL_TO=zipporahnjeri888@gmail.com
FLARE_SMTP_USER=zipporahnjeri888@gmail.com
# For Gmail use an App Password (16 characters; needs 2-Step Verification), not your normal password.
FLARE_SMTP_PASSWORD=nekwvdtxirbisogh
FLARE_SMTP_HOST=smtp.gmail.com
FLARE_SMTP_PORT=587

# --- Slack-style webhook alerts (optional) ---
FLARE_WEBHOOK_URL=
